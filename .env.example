# ApplyPilot Environment Configuration
# Copy to ~/.applypilot/.env and fill in your values.

# LLM Provider (pick one)
# Optional. Not used by `applypilot apply` (that uses the Codex CLI).
GEMINI_API_KEY=           # Only for the older score / cover-letter commands
# OPENAI_API_KEY=         # OpenAI (GPT-4o-mini)
# LLM_URL=http://127.0.0.1:8080/v1  # Local LLM (llama.cpp, Ollama)
# LLM_MODEL=              # Override model name

# Auto-Apply (optional)
CAPSOLVER_API_KEY=        # reCAPTCHA / Turnstile / FunCaptcha
NOPECHA_API_KEY=          # hCaptcha (experimental iCIMS worker)
NOPECHA_EXTENSION=        # lab Chrome loads the official extension when headed
# CHROME_FOR_TESTING_PATH=  # required for --load-extension (branded Chrome 137+ ignores it)

# Proxy (optional, for scraping)
# PROXY=host:port:user:pass
